// JavaScript precedence: shifts above relational/equality; & above ^ above |
// exit: 0
// out: 1
// out: 3
// out: 5
// out: 0
// out: 5
// out: true
// out: true
// out: 8
print 1 | 2 ^ 3;
print 2 ^ 3 & 1;
print 4 | 1 & 3;
print 1 & 1 << 2;
print 1 | 1 << 2;
print 1 << 2 == 4;
print 1 << 2 < 8;
print 1 << 2 + 1;
