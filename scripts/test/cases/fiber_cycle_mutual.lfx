// fiber: mutual resume cycle A<->B rejected by the same guard;
// B's failure is delivered back to A as the resume result
// exit: 0
// err: Can't resume a running coroutine.
// out: true
var a = @ctor.Fiber(lambda() {
	var r = resume b;
	return r;
});
var b = @ctor.Fiber(lambda() {
	resume a;
});
print @object.isError(resume a);
