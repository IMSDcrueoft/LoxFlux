print 5 | 3;
print 5 ^ 3;
print 1 << 4;
print 16 >> 2;
print ~5;
print typeof 1;
print typeof nil;
print 1 < 2 and 2 < 3;
print 1 > 2 or 2 > 3;
print 1 == 1.0;
print "a" != "b";
