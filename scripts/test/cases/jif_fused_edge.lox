var g = 0;

print(jif_less_ll(1, 2) and !jif_less_ll(2, 2) and !jif_less_ll(2, 1));
print(jif_greater_ll(3, 2) and !jif_greater_ll(2, 2) and !jif_greater_ll(2, 3));
print(jif_le_ll(1, 2) and jif_le_ll(2, 2) and !jif_le_ll(3, 2));
