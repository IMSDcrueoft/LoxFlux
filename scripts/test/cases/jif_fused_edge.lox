// out: JIF EDGE OK
// JIF fused compare+jump super instructions (emitBranchJump):
// LL = local vs local, LN = local vs number constant, LC = local vs
// non-number constant, stack forms keep the left operand on the stack.
// > / >= reuse the LESS forms via slot swap; const-on-left flips direction.
// Conditions must live in FUNCTIONS: top-level vars are globals and take
// the stack-operand path. Folded constants and compound (and/or) conditions
// must never fuse; the guard cases pin that behavior too.

// --- LL forms: OP_JIF_LESS_LL / _LESS_EQUAL_LL / _EQUAL_LL / _NOT_EQUAL_LL ---

fun jif_less_ll(a, b) {
	var r = 0;
	if (a < b) { r = 1; }
	return r == 1;
}

fun jif_greater_ll(a, b) {
	var r = 0;
	if (a > b) { r = 1; }
	return r == 1;
}

fun jif_le_ll(a, b) {
	var r = 0;
	if (a <= b) { r = 1; }
	return r == 1;
}

fun jif_ge_ll(a, b) {
	var r = 0;
	if (a >= b) { r = 1; }
	return r == 1;
}

fun jif_eq_ll(a, b) {
	var r = 0;
	if (a == b) { r = 1; }
	return r == 1;
}

fun jif_ne_ll(a, b) {
	var r = 0;
	if (a != b) { r = 1; }
	return r == 1;
}

fun jif_str_ll(sa, sb) {
	var r = 0;
	if (sa < sb) { r = 1; }
	if (sa > sb) { r = r + 10; }
	return r == 1 or r == 10;
}

fun jif_early(a, b) {
	if (a < b) { return "lt"; }
	if (a == b) { return "eq"; }
	return "gt";
}

// --- LN forms: local vs number constant ---

fun jif_less_ln(x) {
	var r = 0;
	if (x < 5) { r = 1; }
	return r == 1;
}

fun jif_le_ln(x) {
	var r = 0;
	if (x <= 5) { r = 1; }
	return r == 1;
}

fun jif_gt_ln(x) {
	var r = 0;
	if (x > 5) { r = 1; }
	return r == 1;
}

fun jif_ge_ln(x) {
	var r = 0;
	if (x >= 5) { r = 1; }
	return r == 1;
}

fun jif_eq_ln(x) {
	var r = 0;
	if (x == 5) { r = r + 1; }
	if (x != 5) { r = r + 10; }
	return r == 1 or r == 10;
}

fun jif_neg_ln(x) {
	var r = 0;
	if (x < -3) { r = 1; }
	if (x >= -3) { r = r + 10; }
	return r == 1 or r == 10;
}

// const on the left: direction flips to GREATER/GREATER_EQUAL (== / != commute)

fun cl_flip_1(x) {
	var r = 0;
	if (5 < x) { r = r + 1; }
	if (5 <= x) { r = r + 10; }
	return r == 11;
}

fun cl_flip_2(x) {
	var r = 0;
	if (5 > x) { r = r + 1; }
	if (5 >= x) { r = r + 10; }
	return r == 11;
}

fun cl_flip_3(x) {
	var r = 0;
	if (5 == x) { r = r + 1; }
	if (5 != x) { r = r + 10; }
	return r == 1 or r == 10;
}

// --- LC forms: equality vs non-number constant (24bit vm.constants) ---

fun jif_eq_lc(s) {
	var r = 0;
	if (s == "hit") { r = 1; }
	return r == 1;
}

fun jif_eq_lc_mixed(v) {
	var r = 0;
	if (v == "hit") { r = 1; }
	return r == 0;
}

fun jif_ne_lc(s) {
	var r = 0;
	if (s != "hit") { r = 1; }
	return r == 1;
}

fun jif_eq_cl(s) {
	var r = 0;
	if ("hit" == s) { r = 1; }
	return r == 1;
}

fun jif_ne_cl(s) {
	var r = 0;
	if ("hit" != s) { r = 1; }
	return r == 1;
}

// --- stack-operand NUMBER forms: computed left operand vs number constant ---

fun st_num_lt(a, b) {
	var r = 0;
	if (a + b < 10) { r = 1; }
	return r == 1;
}

fun st_num_le(a, b) {
	var r = 0;
	if (a + b <= 10) { r = 1; }
	return r == 1;
}

fun st_num_gt(a, b) {
	var r = 0;
	if (a * b > 12) { r = 1; }
	return r == 1;
}

fun st_num_ge(a, b) {
	var r = 0;
	if (a - b >= 2) { r = 1; }
	return r == 1;
}

fun st_num_eq(a, b) {
	var r = 0;
	if (a + b == 10) { r = 1; }
	return r == 1;
}

fun st_num_ne(a, b) {
	var r = 0;
	if (a + b != 10) { r = 1; }
	return r == 1;
}

// stack forms with number-constant arithmetic (OP_*_NUMBER feeding the JIF tail)

fun st_arith_sub(x) {
	var r = 0;
	if (x - 2 < 10) { r = 1; }
	return r == 1;
}

fun st_arith_mul(x) {
	var r = 0;
	if (x * 2 == 10) { r = 1; }
	return r == 1;
}

fun st_arith_div(x) {
	var r = 0;
	if (x / 2 > 3) { r = 1; }
	return r == 1;
}

fun st_arith_mod(x) {
	var r = 0;
	if (x % 3 == 1) { r = 1; }
	return r == 1;
}

// --- stack-operand LOCAL forms: computed left operand vs local slot ---

fun st_loc_lt(a, b, c) {
	var r = 0;
	if (a + b < c) { r = 1; }
	return r == 1;
}

fun st_loc_le(a, b, c) {
	var r = 0;
	if (a + b <= c) { r = 1; }
	return r == 1;
}

fun st_loc_gt(a, b, c) {
	var r = 0;
	if (a + b > c) { r = 1; }
	return r == 1;
}

fun st_loc_ge(a, b, c) {
	var r = 0;
	if (a * b >= c) { r = 1; }
	return r == 1;
}

fun st_loc_eq(a, b, c) {
	var r = 0;
	if (a + b == c) { r = 1; }
	return r == 1;
}

fun st_loc_ne(a, b, c) {
	var r = 0;
	if (a + b != c) { r = 1; }
	return r == 1;
}

// --- stack forms with property / subscript / global / call receivers ---

class Box {
	init(v) { this.v = v; }
}

fun st_prop_lt(v) {
	var obj = Box(v);
	var r = 0;
	if (obj.v < 10) { r = 1; }
	return r == 1;
}

fun st_prop_ge(v) {
	var obj = Box(v);
	var r = 0;
	if (obj.v >= 10) { r = 1; }
	return r == 1;
}

fun st_prop_eq_loc(v, c) {
	var obj = Box(v);
	var r = 0;
	if (obj.v == c) { r = 1; }
	return r == 1;
}

fun st_prop_str(s) {
	var obj = Box(1);
	obj.tag = s;
	var r = 0;
	if (obj.tag == "hit") { r = 1; }
	if (obj.tag != "hit") { r = r + 10; }
	return r == 1 or r == 10;
}

fun st_sub_lt(i) {
	var arr = [1, 5, 9];
	var r = 0;
	if (arr[i] < 5) { r = 1; }
	return r == 1;
}

fun st_global_lt() {
	g = 9;
	var r = 0;
	if (g < 5) { r = 1; }
	g = 2;
	if (g < 5) { r = r + 10; }
	return r == 10;
}

fun two() { return 2; }

fun st_call_eq() {
	var r = 0;
	if (two() == 2) { r = 1; }
	if (two() == 3) { r = r + 10; }
	return r == 1;
}

// --- fused conditions in loops (exit jump patched across the back edge) ---

fun loop_while() {
	var i = 0;
	while (i < 3) { i = i + 1; }
	return i == 3;
}

fun loop_while_ll(n) {
	var i = 0;
	var c = 0;
	while (i < n) { c = c + 1; i = i + 1; }
	return c == n;
}

fun loop_dowhile() {
	var i = 0;
	do { i = i + 1; } while (i < 3);
	return i == 3;
}

fun loop_dowhile_once() {
	var hits = 0;
	do { hits = hits + 1; } while (false);
	return hits == 1;
}

fun loop_for() {
	var s = 0;
	for (var i = 0; i < 3; i = i + 1) { s = s + i; }
	return s == 3;
}

// --- guards: folded constants and compound conditions must not fuse ---

fun guard_fold_true() {
	var r = 0;
	if (true) { r = 1; } else { r = 10; }
	if (1 < 2) { r = r + 10; } else { r = r + 100; }
	return r == 11;
}

fun guard_fold_false() {
	var r = 0;
	if (false) { r = 1; } else { r = 10; }
	if (2 < 1) { r = r + 1; } else { r = r + 10; }
	return r == 20;
}

fun guard_nil_eq(x) {
	var r = 0;
	if (x == nil) { r = 1; }
	return r == 1;
}

fun guard_or(a, b) {
	if (a or b) { return 1; }
	return 0;
}

fun guard_or_cmp(a, b, c) {
	if (a or b < c) { return 1; }
	return 0;
}

fun guard_and_cmp(a, b, c, d) {
	if (a < b and c < d) { return 1; }
	return 0;
}

fun guard_not(x) {
	var r = 0;
	if (!x) { r = 1; }
	return r == 1;
}

fun elseif_chain(x) {
	if (x < 0) { return -1; }
	else if (x == 0) { return 0; }
	return 1;
}

