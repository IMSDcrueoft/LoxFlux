// probe-first connect + escape interning: identical results must dedupe to a
// single pooled string (connect hit path, repeated escape literals, a
// zero-length segment, and an escape literal long enough for the heap scratch)
// exit: 0
// out: abab
// out: abab
// out: true
// out: a	b
// out: a	b
// out: true
// out: x\y
// out: x\y
// out: true
// out: 300
// out: true
var a = "a" + "b";
print a + a;
print "a" + "b" + "a" + "b";
print ("" + "a" + "b") == a;

var t1 = "a\tb";
var t2 = "a\tb";
print t1;
print t2;
print t1 == t2;

var x1 = "x\\y";
var x2 = "x\\y";
print x1;
print x2;
print x1 == x2;

