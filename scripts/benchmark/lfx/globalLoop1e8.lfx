var start = @time.milli();
var i;
for(i = 0;i<100000000;){
    i = i+1;
}
print "globalLoop1:", @time.milli() - start;

start = @time.milli();
i = 0;
while(i<100000000){
    i = i+1;
}
print "globalLoop1:", @time.milli() - start;

