// OP_JIF fusion vs scoping: shadowing, closures (upvalue capture),
// per-function constant pools, for-loop variables

// ---- B1: shadowing - same name, different slots ----
{
    var i = 1;
    {
        var i = 2;
        if (i == 2) { print "B1 inner ok"; } else { print "B1 inner wrong"; }
        while (i > 1) { i = i - 1; }   // inner i: 2 -> 1
        print i; // expect 1 (inner)
    }
    if (i == 1) { print "B1 outer ok"; } else { print "B1 outer wrong"; }
    while (i < 3) { i = i + 1; }       // outer i: 1 -> 3
    print i; // expect 3 (outer)
}

// ---- B2: closure capture does not disturb fused local compare ----
fun capTest() {
    var x = 5;
    fun get() { return x; }   // captures x as upvalue
    var n = 0;
    while (x > 0) {           // fused LL on captured local
        x = x - 1;
        n = n + 1;
    }
    print n;      // expect 5
    print get();  // expect 0 (same captured local)
}
capTest();

// ---- B3: per-function constant pool (LC uses function's own pool) ----
fun poolTest(a) {
    var i = 0;
    while (i < 3) {     // const 3 lives in poolTest's own pool
        i = i + 1;
    }
    while (i < 30) {    // const 30 in the same pool
        i = i + 10;
    }
    return i + a;       // 33 + a
}
print poolTest(1);  // expect 34
print poolTest(2);  // expect 35

// ---- B4: for-loop variable in fused condition ----
{
    var sum = 0;
    for (var k = 0; k < 4; k = k + 1) {
        sum = sum + k;
    }
    print sum; // expect 6

    // loop var compared against another local
    var limit = 3;
    var cnt = 0;
    for (var k = 0; k < limit; k = k + 1) {
        cnt = cnt + 1;
    }
    print cnt; // expect 3
}

// ---- B5: captured variable mutated through closure, fused loop before/after ----
fun outer2() {
    var step = 4;
    fun bump() { step = step + 1; return step; }
    var acc = 0;
    var i = 0;
    while (i < step) {      // fused; step stable during the loop
        acc = acc + 1;
        i = i + 1;
    }
    print acc;  // expect 4
    bump();
    bump();
    print step; // expect 6 (bumped twice after the loop)
    while (i < step) {      // fused again; re-checks the mutated capture
        acc = acc + 1;
        i = i + 1;
    }
    print acc;  // expect 6
}
outer2();

print "jif scope tests done";
