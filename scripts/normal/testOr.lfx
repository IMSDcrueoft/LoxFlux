// JUMP_IF_TRUE (or_) dual-exit smoke test
print (false or 42); // expect: 42
print (nil or "x"); // expect: x
print (1 or 2); // expect: 1
print (false or nil); // expect: nil
print ("a" or "b"); // expect: a
var a = false;
var b = 7;
print (a or b); // expect: 7
print (b or a); // expect: 7
print "or tests done"; // expect: or tests done
