// opt_folded.lfx
// conditions that constant-fold at compile time into a single bool byte (or a number constant)
// expected prints: 12 13 15 17 20 22 23 25 28 29 31 33 36 37 39 41 42 44 45 46 48 50 51 99

if (!true) print 11; else print 12;
if (!false) print 13; else print 14;
if (!nil) print 15; else print 16;
if (1 == 1) print 17; else print 18;
if (1 == 2) print 19; else print 20;
if (1 != 1) print 21; else print 22;
if ("a" == "a") print 23; else print 24;
if (1 < 2) print 25; else print 26;
if (2 <= 1) print 27; else print 28;
if (-(1)) print 29; else print 30;
if (true == true) print 31; else print 32;
if (nil == nil) print 33; else print 34;
if (nil == false) print 35; else print 36;
if (1 + 2 == 3) print 37; else print 38;
if (1 + 2) print 39; else print 40;

while (!false) { print 41; break; } print 42;
while (1 == 2) { print 43; } print 44;
do { print 45; break; } while (nil == nil); print 46;

branch { !true: print 47; none: print 48; }
branch { 1 == 2: print 49; none: print 50; }
branch { 1 == 1: print 51; none: print 52; }

print 99;
