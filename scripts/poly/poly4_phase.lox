class A { m() { return 1; } }
class B { m() { return 2; } }
var a = A();
var b = B();
var obj = a;
var i = 0;
var s = 0;
var flip = false;
var until = 100000;
var start = clock();
while (i < 3000000) {
  s = s + obj.m();
  until = until - 1;
  if (until == 0) {
    until = 100000;
    if (flip) {
      obj = a;
      flip = false;
    } else {
      obj = b;
      flip = true;
    }
  }
  i = i + 1;
}
print "phase";
print clock() - start;
