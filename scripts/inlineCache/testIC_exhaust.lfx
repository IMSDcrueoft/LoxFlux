//IC slot exhaustion: more than 255 property sites in one function
//first 255 sites get real slots, the rest share the sentinel slot (operand 0)
//the trailing invoke site is also exhausted -> covers the invoke sentinel path
var passCount = 0;

fun checkEq(name, actual, expected) {
	if (actual != expected) {
		print "FAIL: " + name;
		print "  expected:";
		print expected;
		print "  actual:";
		print actual;
		throw "assertion failed";
	}
	passCount = passCount + 1;
}

class Obj {
	init(v) {
		this.f = v;
	}
	m() {
		return this.f * 2;
	}
}

class ObjPadded {
	init(v) {
		this.p0 = 0;
		this.p1 = 0;
		this.p2 = 0;
		this.p3 = 0;
		this.p4 = 0;
		this.p5 = 0;
		this.p6 = 0;
		this.p7 = 0;
		this.p8 = 0;
		this.p9 = 0;
		this.f = v;
	}
}

