{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows (MSVC via Visual Studio)",
      "description": "Uses the Visual Studio generator with the default installed toolset.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows (Ninja Multi-Config)",
      "description": "Uses Ninja with MSVC, supports Debug/Release multi-config.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "unix",
      "displayName": "Unix Makefiles",
      "description": "Generic Unix/Linux build (uses system allocator unless mimalloc is found).",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "unix-debug",
      "displayName": "Unix Makefiles (Debug)",
      "description": "Debug build for Unix/Linux.",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja",
      "configuration": "Release"
    },
    {
      "name": "windows-ninja-debug",
      "configurePreset": "windows-ninja",
      "configuration": "Debug"
    },
    {
      "name": "unix",
      "configurePreset": "unix"
    },
    {
      "name": "unix-debug",
      "configurePreset": "unix-debug"
    }
  ]
}
