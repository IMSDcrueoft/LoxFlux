{
  "name": "loxflux-syntax-highlight",
  "displayName": "LoxFlux Syntax Highlight",
  "description": "Syntax highlighting for loxFlux.",
  "version": "0.0.5",
  "publisher": "IMSDCrueoft",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/IMSDcrueoft/LoxFlux.git"
  },
  "engines": {
    "vscode": "^1.64.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "loxflux",
        "aliases": [
          "LoxFlux",
          "loxflux"
        ],
        "extensions": [
          ".lfx",
          ".lox"
        ],
        "icon": {
          "light": "./icons/lfx-file.svg",
          "dark": "./icons/lfx-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loxflux",
        "scopeName": "source.lfx",
        "path": "./syntaxes/loxflux.tmLanguage.json"
      }
    ]
  }
}